# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: primary model for classification and photo checks
# GEMINI_MODEL=gemini-3.6-flash
# Optional: total AI time budget per request, in ms
# GEMINI_TIMEOUT_MS=25000

# Staff sign-in. Required in production (roles without a passcode can't sign in).
# Dev defaults: admin123, and roads123 / sanitation123 / electricity123 / water123 / drainage123 / general123
ADMIN_PASSCODE=admin123
# DEPT_PASSCODES={"Public Works (Roads)":"…","Sanitation":"…","Electricity Board (TANGEDCO)":"…","Water Supply":"…","Drainage & Sewerage":"…","General Administration":"…"}

# Secret used to derive citizens' private links (set a long random value in production)
# LINK_SECRET=

# Optional: Google Maps Platform key with "Places API (New)" enabled, for address autocomplete
# on the report form. Without it, the search box falls back to OpenStreetMap search.
# GOOGLE_MAPS_API_KEY=

# Phone verification (OTP). SMS is a stub until a provider is connected: while SMS_PROVIDER
# is unset, the code is shown on screen. OTP_SECRET signs codes (defaults to LINK_SECRET).
# SMS_PROVIDER=
# OTP_SECRET=

# "file" (default, ./data/tickets.json) or "firestore" (Cloud Run)
STORE=file

# Optional email notifications via Gmail SMTP (use an App Password)
# SMTP_URL=smtps://you%40gmail.com:app-password@smtp.gmail.com:465
# SMTP_FROM=CivicResolve <you@gmail.com>
# PUBLIC_BASE_URL=https://civicresolve-xxxxx.a.run.app

# Optional: rate limit for submissions per IP
# RATE_MAX=10
# RATE_WINDOW_MS=600000
